# AI provider
# Optional. Defaults to gemini. Supported now: gemini.
RESUME_QA_AI_PROVIDER=gemini

# Required. Server-side system instruction for the resume Q&A agent.
# Keep the real value in .env.local / Vercel env only, not in git.
# In Vercel, paste the prompt value without surrounding quotes.
# You can use {{RESUME_QA_REFUSAL_ANSWER}} inside the prompt.
RESUME_QA_SYSTEM_INSTRUCTION=

# Required. Server-side JSON arrays of private regex policy configs.
# Keep real values in .env.local / Vercel env only, not in git.
# Format: [{"source":"regex source","flags":"i"}]
RESUME_QA_BLOCKED_TEXT_PATTERNS=
RESUME_QA_LEAK_PATTERNS=

# Gemini provider
# Required when RESUME_QA_AI_PROVIDER=gemini. Server-side only. Do not expose this as NEXT_PUBLIC_*.
GEMINI_API_KEY=

# Optional. Defaults to gemini-3.1-flash-lite.
GEMINI_MODEL=gemini-3.1-flash-lite

# Optional Gemini generation controls.
# Leave GEMINI_TEMPERATURE empty to use the model default. Gemini 3 recommends the default 1.0.
GEMINI_MAX_OUTPUT_TOKENS=4096
GEMINI_THINKING_LEVEL=low
# GEMINI_TEMPERATURE=

# Optional. Defaults to the public Google Gemini API endpoint.
# Override only if Google changes the endpoint or you intentionally proxy Gemini.
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models

# Redis rate limit store
# Optional. When Redis is unreachable the app keeps answering and falls back to an in-memory
# global daily cap (RESUME_QA_DEGRADED_DAILY_LIMIT) instead of rejecting every request.
# Use the Vercel Marketplace Redis URL or local Redis URL.
REDIS_URL=redis://localhost:6379

# The app also reads these fallback URL names when present:
# KV_URL=
# REDIS_CONNECTION_STRING=

# Resume Q&A limits
# Optional. Defaults are shown below.
RESUME_QA_DAILY_LIMIT=500
RESUME_QA_IP_MINUTE_LIMIT=6
RESUME_QA_IP_DAILY_LIMIT=50

# Optional. Global daily cap applied only while Redis is unreachable.
# Counted per serverless instance, so keep it well under RESUME_QA_DAILY_LIMIT.
RESUME_QA_DEGRADED_DAILY_LIMIT=60

# Optional. Set a long random value in production so stored IP hashes are app-specific.
RESUME_QA_IP_HASH_SALT=

# Optional. Discord webhook URL for degraded-mode alerts.
# Leave empty to log to the server console only.
RESUME_QA_ALERT_WEBHOOK_URL=
